+// The first registered font that has the character, in the face of its family nearest [style]: a bold run falls back
+// to the bold face of a fallback registered in several weights, not to whichever weight was registered first.
+sk_sp<SkTypeface> TypefaceFontProviderWithFallback::fallbackForChar(SkUnichar character, const SkFontStyle& style) const {
+    auto first = fallbackForChar(character);
+    if (!first) return nullptr;
+    SkString family;
+    first->getFamilyName(&family);
+    auto distance = [&style](const SkFontStyle& other) {
+        return std::abs(other.weight() - style.weight()) + (other.slant() == style.slant() ? 0 : 1000);
+    };
+    auto best = first;
+    auto bestDistance = distance(first->fontStyle());
+    for (const auto& typeface : registeredTypefaces) {
+        if (!typeface || typeface->unicharToGlyph(character) == 0) continue;
+        SkString name;
+        typeface->getFamilyName(&name);
+        if (name != family) continue;
+        auto d = distance(typeface->fontStyle());
+        if (d < bestDistance) {
+            best = typeface;
+            bestDistance = d;
+        }
+    }
+    return best;
+}
